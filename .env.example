# Required: Finnhub API key — free tier at https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# Required: Telegram bot token — get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUVwxyz

# Required: Your Telegram chat ID — run setup_telegram.py to find it
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional: NewsAPI key for additional headline coverage — https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here
